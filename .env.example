# Nous Portal (OpenAI-compatible)
NOUS_API_KEY=replace_me
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
# Local smoke tests without Portal (broker expects IB Gateway by default):
# ALLOW_MOCK_LLM=true
# ALLOW_MOCK_BROKER=true
# SKIP_NOUS_CATALOG_CHECK=true
ALLOW_MOCK_BROKER=false

# Model map (provider-prefixed Portal IDs)
MODEL_FUNDAMENTAL=anthropic/claude-sonnet-5.5
MODEL_TECHNICAL=anthropic/claude-sonnet-5.5
MODEL_SENTIMENT=anthropic/claude-haiku-5.5
MODEL_MACRO=anthropic/claude-sonnet-5.5
MODEL_PORTFOLIO_MANAGER=anthropic/claude-opus-5.5
MODEL_RISK=anthropic/claude-opus-5.5

# Postgres
DATABASE_URL=postgresql+asyncpg://trader:trader@postgres:5432/trader
DATABASE_URL_SYNC=postgresql://trader:trader@postgres:5432/trader

# IBKR Gateway — paper is the only mode started in phase 1
IBKR_TRADING_MODE=paper
IBKR_LIVE_ORDERS_ENABLED=false
IBKR_HOST=ib-gateway
IBKR_PORT=4004
IBKR_CLIENT_ID=7
IBKR_ACCOUNT_ID=DUxxxxxxxx
TWS_USERID=your_ibkr_username
TWS_PASSWORD=your_ibkr_password
TRADING_MODE=paper

# Policy
MAX_POSITION_PCT=0.10
PRICE_BAND_PCT=0.02
PROPOSAL_TTL_MINUTES=30
EXIT_MAX_LOSS_PCT=0.08
EXIT_REVIEW_HOUR_UTC=21
HORIZON_REVIEW_CAP=3
STARTING_CASH=100000
RESTRICTED_TICKERS=

# Paper autopilot. Stays off until set. Ignored unless trading mode is paper
# and live orders are disabled. Runs once each New York weekday, 5 minutes
# after the US open, and approves limit proposals at MEDIUM conviction or higher.
AUTO_TRADE_ENABLED=false
AUTO_TRADE_MINUTES_AFTER_OPEN=5
AUTO_RESEARCH_TOP_N=3
AUTO_MAX_NEW_BUYS=3
AUTO_MIN_CONVICTION=MEDIUM

# Operator console
OPERATOR_USER=operator
OPERATOR_PASSWORD=change_me
API_HOST=0.0.0.0
API_PORT=8000

# ECR images (required for docker-compose.deploy.yml on a Linux box / VM)
# ECR_API_IMAGE=123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/trader-api:latest
# ECR_WEB_IMAGE=123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/trader-web:latest
